# Non-secret settings for deploy/compose.yaml (runbook §2.1). Written by cloud-init from Terraform variables.
BAEC_RELEASE=${release}
BAEC_PUBLIC_HOST=${public_hostname}
BAEC_PUBLIC_ORIGIN=${public_hostname}
BAEC_AUTH_ISSUER=${auth_issuer}
BAEC_HSTS_MAX_AGE=86400
BAEC_TLS_DIR=/etc/baec/tls
BAEC_SECRETS_DIR=/etc/baec/secrets
BAEC_BACKUP_STAGING_DIR=/var/lib/baec/backup-staging
BAEC_DB_POOL_MAX_SIZE=4
BAEC_AUTH_DB_POOL_MAX_SIZE=2
