# baecctl settings (names and identifiers only; no secret). Written by cloud-init from Terraform.
AWS_REGION_NAME=${region}
BAEC_ENVIRONMENT=${environment}
BAEC_RELEASE=${release}
BAEC_BACKUPS_BUCKET=${backups_bucket}
BAEC_BACKUPS_KEY_ARN=${backups_key_arn}
BAEC_RELEASES_BUCKET=${releases_bucket}
BAEC_IMAGE_WEB=${image_web}
BAEC_IMAGE_PROXY=${image_proxy}
BAEC_IMAGE_OPS=${image_ops}
BAEC_DB_HOST=${db_host}
